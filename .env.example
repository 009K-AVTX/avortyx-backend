# Copy to .env and fill in. Never commit .env.
# a long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# 0 for plain-http local runs; leave 1 in production (https)
SESSION_COOKIE_SECURE=0
# 1 when the app sits behind a proxy or platform load balancer that terminates https
BEHIND_PROXY=0
DATABASE_URL=sqlite:///avortyx.db

# the sites allowed to post applications (comma separated)
CORS_ORIGINS=https://avortyx.com,https://www.avortyx.com,https://avortyx-prototype.vercel.app,http://localhost:5199

# this backend's own https address (the Telegram webhook and "Open in panel" links use it)
PUBLIC_URL=https://api.avortyx.com
# the website, linked from the emails applicants get
SITE_URL=https://www.avortyx.com

# Telegram bot (@AvortyxCareersBot): the token from @BotFather. Secret: only in .env, never here.
# Each team member links their own Telegram in Panel -> Settings -> Connect Telegram; nothing
# else is needed for that.
TELEGRAM_BOT_TOKEN=
# the bot's @username, without @ (optional: read from Telegram when empty)
TELEGRAM_BOT_USERNAME=AvortyxCareersBot
# the notification group: every application and access request (an id like -100...).
# (TELEGRAM_CHAT_ID, the older name, still works)
TELEGRAM_NOTIFY_CHAT_ID=
# the team support group: the website's help chat goes here, and replying to a chat message there
# answers the visitor in their chat box. Add the bot to the group first. A public group's
# @username works; the -100... id keeps working if the group is made private (recommended).
TELEGRAM_SUPPORT_CHAT_ID=@Avortyx_Sup
# a long random string; Telegram sends it back on every webhook call so nobody else can
# python3 -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=
# how long a "Connect Telegram" link works, in minutes
TELEGRAM_LINK_TTL_MINUTES=15

# Email (SMTP). Hostinger mailbox: smtp.hostinger.com, port 465, the mailbox address and password
# (the password only in .env, never here)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=009k@avortyx.com
SMTP_PASS=
SMTP_FROM=009k@avortyx.com
# the sender name people see
MAIL_FROM_NAME=Avortyx Careers
# who receives every application by email (comma separated)
CAREERS_EMAIL_TO=009k@avortyx.com
# where applicants' replies go (empty = the first CAREERS_EMAIL_TO address)
CAREERS_REPLY_TO=
# 1 = email each applicant a "we received your application" note with their reference
SEND_APPLICANT_CONFIRMATION=1

# where CVs are kept, and the largest CV accepted (bytes)
UPLOAD_DIR=uploads
MAX_CV_BYTES=4194304
