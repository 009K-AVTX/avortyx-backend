[Unit]
Description=Avortyx backend (gunicorn)
After=network.target

[Service]
User=avortyx
Group=avortyx
WorkingDirectory=/srv/avortyx-backend
EnvironmentFile=/srv/avortyx-backend/.env
ExecStart=/srv/avortyx-backend/venv/bin/gunicorn wsgi:app --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile -
Restart=always
RestartSec=3
# only the data folder is writable
ProtectSystem=full
ReadWritePaths=/var/lib/avortyx
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
